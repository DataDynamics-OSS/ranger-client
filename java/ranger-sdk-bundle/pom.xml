<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.datadynamics.ranger.client</groupId>
        <artifactId>ranger-sdk-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>ranger-sdk-bundle</artifactId>
    <name>ranger-sdk-bundle</name>
    <description>All SDK modules and dependencies in one shaded jar for offline installs</description>

    <dependencies>
        <dependency>
            <groupId>io.datadynamics.ranger.client</groupId>
            <artifactId>ranger-sdk-admin</artifactId>
        </dependency>
        <dependency>
            <groupId>io.datadynamics.ranger.client</groupId>
            <artifactId>ranger-sdk-pdp</artifactId>
        </dependency>
        <dependency>
            <groupId>io.datadynamics.ranger.client</groupId>
            <artifactId>ranger-sdk-kms</artifactId>
        </dependency>
        <dependency>
            <groupId>io.datadynamics.ranger.client</groupId>
            <artifactId>ranger-sdk-auth-kerberos</artifactId>
        </dependency>
        <dependency>
            <groupId>io.datadynamics.ranger.client</groupId>
            <artifactId>ranger-sdk-policy-as-code</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>true</createDependencyReducedPom>
                            <!-- Relocate Jackson and SnakeYAML so the bundle never clashes with the host's versions. -->
                            <relocations>
                                <relocation>
                                    <pattern>com.fasterxml.jackson</pattern>
                                    <shadedPattern>io.datadynamics.ranger.client.shaded.jackson</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.yaml.snakeyaml</pattern>
                                    <shadedPattern>io.datadynamics.ranger.client.shaded.snakeyaml</shadedPattern>
                                </relocation>
                            </relocations>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <manifestEntries>
                                        <Automatic-Module-Name>io.datadynamics.ranger.client.bundle</Automatic-Module-Name>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

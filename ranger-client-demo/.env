# Demo stack settings. These are the public defaults of the Apache Ranger docker images;
# the stack is for local testing only.
RANGER_VERSION=2.9.0
# Java 8 variant: Ranger 2.9.0 PDP needs JAXB, which Java 11+ no longer bundles (same as upstream dev-support).
RANGER_BASE_VERSION=20260918-1-8

# Postgres superuser, Ranger Admin DB user, and Ranger Admin's "admin" login (the official image uses one value for both).
POSTGRES_PASSWORD=rangerR0cks!
RANGER_PASSWORD=rangerR0cks!
RANGER_KMS_DB_PASSWORD=rangerR0cks!
KMS_MASTER_KEY_PASSWORD=Str0ngPassw0rd

# Host ports
ADMIN_PORT=6080
KMS_PORT=9292
PDP_PORT=6500
APP_PORT=8080
